### Global variables
@baseUrl = http://procureflow.test/api
@contentJson = application/json
@userId = 019f55bc-feb2-71b2-928a-3841c4031c2e

### POST /login
# @name login
POST {{baseUrl}}/auth/login
Content-Type: {{contentJson}}

{
    "email": "ekadianharis@gmail.com",
    "password": "password123"
}

### GET /list
GET {{baseUrl}}/users/list
Accept: {{contentJson}}
Authorization: Bearer {{login.response.body.data.token}}


### GET /users - dengan pagination eksplisit
GET {{baseUrl}}/users/list?page=2&per_page=10
Accept: {{contentJson}}
Authorization: Bearer {{login.response.body.data.token}}

### GET /users - dengan search
GET {{baseUrl}}/users/list?search=ekadian
Accept: {{contentJson}}
Authorization: Bearer {{login.response.body.data.token}}

### GET /users - sort ascending by name
GET {{baseUrl}}/users/list?sort=name
Accept: {{contentJson}}
Authorization: Bearer {{login.response.body.data.token}}

### GET /users - sort descending by email
GET {{baseUrl}}/users/list?sort=-email
Accept: {{contentJson}}
Authorization: Bearer {{login.response.body.data.token}}

### GET /users - kombinasi search + sort + pagination
GET {{baseUrl}}/users/list?search=haris&sort=-created_at&page=1&per_page=20
Accept: {{contentJson}}
Authorization: Bearer {{login.response.body.data.token}}

### POST /users - Create a new user records
POST {{baseUrl}}/users
Content-Type: {{contentJson}}
Accept: {{contentJson}}
Authorization: Bearer {{login.response.body.data.token}}

{
    "name": "nyannn",
    "email": "nyan@gmail.com",
    "password": "password123",
    "role_id": "019f5573-05de-704b-b873-ef8ba03c1fda"
}

### POST /users - Create a new user records with wrong email, password and role_id
POST {{baseUrl}}/users
Content-Type: {{contentJson}}
Accept: {{contentJson}}
Authorization: Bearer {{login.response.body.data.token}}

{
    "name": "eka",
    "email": "eka",
    "password": "",
    "role_id": "019f558b-72bc-72a9-b75a-0df5c253d08c"
}

### Get /users/{publicId} - Get detailed info of a user
GET {{baseUrl}}/users/{{userId}}
Accept: {{contentJson}}
Authorization: Bearer {{login.response.body.data.token}}

### Get /users/{publicId} - Get detailed info of a user with wrong ID
GET {{baseUrl}}/users/019f558b-72bc-72a9-b75a-0df5c253d08c
Accept: {{contentJson}}
Authorization: Bearer {{login.response.body.data.token}}

### PUT /users/{publicId} - Update a user info
PUT {{baseUrl}}/users/{{userId}}
Content-Type: {{contentJson}}
Accept: {{contentJson}}
Authorization: Bearer {{login.response.body.data.token}}

{
    "name": "nyanw",
    "email": "nyanw@gmail.com",
    "is_active": "1"
}

### DELETE /users/{publicId}
DELETE {{baseUrl}}/users/{{userId}}
Accept: {{contentJson}}
Authorization: Bearer {{login.response.body.data.token}}

### PUT /users/{publicId}/roles
PUT {{baseUrl}}/users/{{userId}}/roles
Content-Type: {{contentJson}}
Accept: {{contentJson}}
Authorization: Bearer {{login.response.body.data.token}}

{
    "role_id": "019f5573-05ef-7126-8e72-ca2e77af1372"
}