### Global variables
@baseUrl = http://procureflow.test/api
@contentJson = application/json
@supplierId = 019f569c-c630-72b4-8f6c-924d2dd4fd0a

### POST /login
# @name login
POST {{baseUrl}}/auth/login
Content-Type: {{contentJson}}

{
    "email": "ekadianharis@gmail.com",
    "password": "password123"
}

### GET /list
GET {{baseUrl}}/suppliers/list
Accept: {{contentJson}}
Authorization: Bearer {{login.response.body.data.token}}


### GET /suppliers - dengan pagination eksplisit
GET {{baseUrl}}/suppliers/list?page=1&per_page=10
Accept: {{contentJson}}
Authorization: Bearer {{login.response.body.data.token}}

### GET /suppliers - dengan search
GET {{baseUrl}}/suppliers/list?search=tambak
Accept: {{contentJson}}
Authorization: Bearer {{login.response.body.data.token}}

### GET /suppliers - sort ascending by name
GET {{baseUrl}}/suppliers/list?sort=name
Accept: {{contentJson}}
Authorization: Bearer {{login.response.body.data.token}}

### GET /suppliers - sort descending by email
GET {{baseUrl}}/suppliers/list?sort=-email
Accept: {{contentJson}}
Authorization: Bearer {{login.response.body.data.token}}

### GET /suppliers - kombinasi search + sort + pagination
GET {{baseUrl}}/suppliers/list?search=tambak&sort=-created_at&page=1&per_page=20
Accept: {{contentJson}}
Authorization: Bearer {{login.response.body.data.token}}

### POST /suppliers - Create a new suppliers records
POST {{baseUrl}}/suppliers
Content-Type: {{contentJson}}
Accept: {{contentJson}}
Authorization: Bearer {{login.response.body.data.token}}

{
    "name": "PT Rudeu",
    "email": "mt@gmail.com",
    "phone": "087761232098",
    "address": "Jl. Milis 123",
    "metadata": ""
}

### POST /suppliers - Create a new suppliers records with wrong email, password and role_id
POST {{baseUrl}}/suppliers
Content-Type: {{contentJson}}
Accept: {{contentJson}}
Authorization: Bearer {{login.response.body.data.token}}

{
    "name": "tambak wedi group",
    "email": "twgroup",
    "phone": "087763211098",
    "address": "Jl. Siwalankerto 123",
    "metadata": ""
}

### Get /suppliers/{publicId} - Get detailed info of a suppliers
GET {{baseUrl}}/suppliers/{{supplierId}}
Accept: {{contentJson}}
Authorization: Bearer {{login.response.body.data.token}}

### Get /suppliers/{publicId} - Get detailed info of a suppliers with wrong ID
GET {{baseUrl}}/suppliers/019f569c-c630-72b4-8f6c-924d2dd4fdas
Accept: {{contentJson}}
Authorization: Bearer {{login.response.body.data.token}}

### PUT /suppliers/{publicId} - Update a suppliers info
PUT {{baseUrl}}/suppliers/{{supplierId}}
Content-Type: {{contentJson}}
Accept: {{contentJson}}
Authorization: Bearer {{login.response.body.data.token}}

{
    "name": "tambak wedi edit",
    "email": "twgroup@gmail.com",
    "phone": "087763212098",
    "address": "Jl. Siwalankerto 123",
    "is_active": "0",
    "metadata": ""
}

### DELETE /suppliers/{publicId}
DELETE {{baseUrl}}/suppliers/{{supplierId}}
Accept: {{contentJson}}
Authorization: Bearer {{login.response.body.data.token}}